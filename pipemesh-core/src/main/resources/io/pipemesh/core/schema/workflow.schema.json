{
  "$comment": "The shape every workflow shares. What a particular step type may say beyond this is declared by the executor that owns the type — see StepExecutor.configSchema().",

  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "entry", "steps"],

  "properties": {
    "id":      { "type": "string" },
    "version": { "type": "string" },
    "entry":   { "type": "string" },

    "retry":     { "$comment": "workflow-wide default; see step-common.schema.json" },
    "timeout":   { "type": "string" },
    "onFailure": { "type": "object" },

    "description": { "type": "string" },

    "budget": {
      "$comment": "What one execution may spend (§39). Absent means unlimited.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCost":       { "type": "string" },
        "maxModelCalls": { "type": "number" },
        "maxTokens":     { "type": "number" }
      }
    },

    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"]
      }
    }
  }
}

{
  "name": "@pipemesh/client",
  "version": "0.1.0",
  "description": "TypeScript client for the PipeMesh workflow runtime",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "proto": "mkdir -p dist/proto && cp ../../proto/pipemesh.proto dist/proto/",
    "build": "tsc && npm run proto",
    "test": "npm run build && node --test dist/test/"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}

{
  "name": "@pipemesh/client",
  "version": "0.1.0",
  "description": "TypeScript client for the PipeMesh workflow runtime",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakbalim/pipemesh.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/burakbalim/pipemesh",
  "bugs": "https://github.com/burakbalim/pipemesh/issues",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "dist/proto",
    "README.md"
  ],
  "scripts": {
    "proto": "mkdir -p dist/proto && cp ../../proto/pipemesh.proto dist/proto/",
    "build": "tsc && npm run proto",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
